{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:standards:swt:release-evidence:core:0.1.0",
  "title": "SWT release-evidence core 0.1.0",
  "description": "Frozen core structure 0.1.0 (initial freeze, not 1.0.0). Describes the shape of PRESENT values only. Absence below stage production is not a schema violation: the evaluator (evaluate() in experimental/check-release-evidence.mjs) yields the outcome not-evaluated for it and never pass. At stage production the required fields below apply. tests[] holds the required test identities; testRuns[] holds execution evidence, one envelope per run, bound to a test by testId. Not expressed here, and not frozen as schema rules: the mapping that every required test has at least one applicable run, unique test ids, testId references, the rule that a declared signing.status not-evaluated is never a pass unless signing.notApplicable is declared, secret scanning, the digest-equality rule between artifact.digest and testRuns[].artifactDigest, record size and depth limits, and the profile-redefinition rule (evaluator only). Retention, approvals, rollback, provenance, distribution, the required fields of the manual branch, and the Standard 02 amendment stay open.",
  "x-coreVersion": "0.1.0",
  "x-frozen": [
    "single envelope with per-kind branches (testRuns[] entries)",
    "tests[] as required test identities",
    "source.dirty",
    "not-evaluated outcome",
    "signing.status not-evaluated is never a pass unless declared not applicable",
    "residualRisks[]",
    "testRuns[]",
    "evaluate() result shape"
  ],
  "x-evaluateShape": {
    "verdict": [
      "pass",
      "reject",
      "not-evaluated"
    ],
    "errors": "string[]",
    "notEvaluated": "string[]"
  },
  "type": "object",
  "properties": {
    "artifact": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/testIdentity"
      }
    },
    "testRuns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testEnvelope"
      }
    },
    "residualRisks": {
      "type": "array"
    },
    "signing": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not-evaluated",
            "attested",
            "ingested",
            "failed"
          ]
        },
        "notApplicable": {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "pattern": "\\S"
            },
            "attestedBy": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "basis",
            "attestedBy"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "attested",
                  "ingested",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "notApplicable"
              ]
            }
          }
        }
      ]
    },
    "stage": {
      "enum": [
        "internal",
        "test",
        "staged",
        "production"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "const": "production"
          }
        }
      },
      "then": {
        "required": [
          "artifact",
          "source",
          "tests",
          "testRuns",
          "signing"
        ],
        "properties": {
          "artifact": {
            "required": [
              "digest"
            ]
          },
          "source": {
            "required": [
              "dirty"
            ],
            "properties": {
              "dirty": {
                "const": false
              }
            }
          },
          "signing": {
            "required": [
              "status"
            ]
          },
          "tests": {
            "items": {
              "required": [
                "id"
              ]
            }
          },
          "testRuns": {
            "items": {
              "required": [
                "testId",
                "evidenceKind",
                "artifactDigest"
              ],
              "allOf": [
                {
                  "if": {
                    "required": [
                      "evidenceKind"
                    ],
                    "properties": {
                      "evidenceKind": {
                        "const": "automated"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "command",
                      "exitCode"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "testIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "testEnvelope": {
      "type": "object",
      "properties": {
        "testId": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidenceKind": {
          "enum": [
            "automated",
            "manual"
          ]
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "\\S"
        },
        "manual": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "evidenceKind"
            ],
            "properties": {
              "evidenceKind": {
                "const": "automated"
              }
            }
          },
          "then": {
            "properties": {
              "command": {
                "type": "string",
                "pattern": "\\S"
              },
              "exitCode": {
                "const": 0
              },
              "manual": {
                "not": {
                  "const": true
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "evidenceKind"
            ],
            "properties": {
              "evidenceKind": {
                "const": "manual"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "exitCode"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
